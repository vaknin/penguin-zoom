# /etc/penguin-signer.env — root:root, mode 600. Placeholders only; the
# service refuses to start while any value still contains REPLACE_ME.
# See README.md for a way to write this file without secrets touching shell
# history.

# Meeting SDK app credentials (Zoom Marketplace > your app > App Credentials).
ZOOM_SDK_KEY=REPLACE_ME_sdk_client_id
ZOOM_SDK_SECRET=REPLACE_ME_sdk_client_secret

# Feature > Event Subscriptions > Secret Token. Optional; without it
# /v1/zoom-webhook answers 503.
ZOOM_WEBHOOK_SECRET=REPLACE_ME_webhook_secret_token

# Optional overrides (defaults shown).
#BIND=127.0.0.1
#PORT=8080
#RATE_PER_HOUR=60
#RATE_BURST=10
#ZOOM_API_BASE=https://api.zoom.us
